    <style>
        :root {
            --pink-light: #ffebf0;
            --pink-main: #ffb7c5; /* Sakura Pink */
            --pink-dark: #ff85a1;
        }

        body {
            background-color: var(--pink-light);
            background-image: url('https://www.transparenttextures.com/patterns/sakura.png'); /* Subtle blossom pattern */
            font-family: 'Comic Sans MS', cursive;
            margin: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            overflow-x: hidden;
            color: #d63384;
        }

        /* Falling Blossoms */
        .petal {
            position: fixed;
            top: -10px;
            z-index: 999;
            pointer-events: none;
            animation: fall linear forwards;
        }

        @keyframes fall {
            to {
                transform: translateY(105vh) rotate(360deg);
            }
        }

        .header-zone {
            text-align: center;
            padding: 20px;
        }

        h1 {
            font-size: 3rem;
            text-shadow: 2px 2px white;
            animation: pulse 2s infinite;
        }

        .usagi-gif {
            width: 200px;
            border-radius: 20px;
            border: 4px solid white;
            box-shadow: 0 0 15px var(--pink-dark);
        }

        /* ENVELOPE STYLING */
        .envelope-wrapper {
            height: 380px;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-top: 50px;
        }

        .envelope {
            position: relative;
            width: 300px;
            height: 200px;
            background: var(--pink-main);
            border-bottom-left-radius: 10px;
            border-bottom-right-radius: 10px;
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
            cursor: pointer;
            transition: 0.5s;
        }

        /* The flap */
        .envelope::before {
            content: "";
            position: absolute;
            top: 0;
            z-index: 2;
            border-left: 150px solid transparent;
            border-right: 150px solid transparent;
            border-top: 100px solid var(--pink-dark);
            transform-origin: top;
            transition: transform 0.5s;
        }

        /* The letter inside */
        .letter {
            position: absolute;
            bottom: 0;
            left: 10px;
            width: 280px;
            height: 180px;
            background: white;
            padding: 20px;
            box-sizing: border-box;
            transition: 0.5s;
            z-index: 1;
            text-align: center;
            overflow-y: auto;
            border-radius: 5px;
            font-size: 0.9rem;
            color: #333;
        }

        /* Open State */
        .envelope.open::before {
            transform: rotateX(180deg);
            z-index: 0;
        }

        .envelope.open .letter {
            transform: translateY(-150px);
            height: 250px;
            z-index: 2;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        /* Runaway Button Zone */
        .btn-container {
            margin-top: 20px;
            height: 150px;
            width: 100%;
            position: relative;
            display: flex;
            justify-content: center;
            gap: 20px;
        }

        button {
            padding: 15px 30px;
            font-size: 1.2rem;
            border-radius: 50px;
            border: none;
            cursor: pointer;
            font-family: 'Comic Sans MS', cursive;
        }

        #yesBtn { background: #ff4d6d; color: white; box-shadow: 0 5px #c9184a; }
        #noBtn { background: #ccc; color: #666; position: absolute; left: 55%; }

        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); }
        }

        .hidden-celebration {
            display: none;
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: white;
            padding: 40px;
            border-radius: 20px;
            border: 5px solid var(--pink-dark);
            z-index: 1000;
            text-align: center;
        }
    </style>
</head>
